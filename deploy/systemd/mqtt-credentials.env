# /etc/akhet/mqtt-credentials.env: MQTT credentials, read only by
# akhet-mqtt.service. systemd reads EnvironmentFile= as root before dropping
# privileges, so the file can stay root-owned and private:
#   install -m 0600 -o root -g root mqtt-credentials.env /etc/akhet/mqtt-credentials.env
# Akhet never takes credentials from arguments and never spools them.
AKHET_MQTT_USERNAME=
AKHET_MQTT_PASSWORD=
