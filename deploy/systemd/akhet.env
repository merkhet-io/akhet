# /etc/akhet/akhet.env: non-secret settings shared by both units.
# Install with: install -m 0644 -o root -g root akhet.env /etc/akhet/akhet.env
#
# One collector per spool file. Do not point a second collector (or a second
# host) at the same file, and keep it on a local filesystem (no NFS/SMB).
AKHET_SPOOL=/var/lib/akhet/spool.sqlite
# Pass the same limit to every process that writes the spool (README).
AKHET_MAX_DB_BYTES=1073741824

# Collector (akhet-mqtt.service)
AKHET_MQTT_HOST=broker.example.internal
AKHET_MQTT_PORT=1883
AKHET_MQTT_TOPIC=sensors/#
# Stable and unique per collector: it names the persistent broker session.
AKHET_MQTT_CLIENT_ID=akhet-edge-01

# Replay (akhet-replay.service)
AKHET_REPLAY_URL=http://receiver.example.internal:8080
AKHET_REPLAY_SINK=central
